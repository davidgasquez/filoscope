{
  "name": "filoscope",
  "version": "0.3.1",
  "description": "A Filecoin knowledge base built for your agents",
  "type": "module",
  "bin": {
    "filoscope": "dist/src/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "SKILL.md",
    "dist/"
  ],
  "scripts": {
    "filoscope": "node --env-file-if-exists=.env src/cli.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "check": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@kreuzberg/node": "^4.10.2",
    "@slack/web-api": "^8.0.0",
    "@tobilu/qmd": "2.8.3",
    "google-auth-library": "^10.9.1",
    "tar": "^7.5.22",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidgasquez/filoscope.git"
  },
  "license": "MIT"
}
